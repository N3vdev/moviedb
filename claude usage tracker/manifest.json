{
  "manifest_version": 3,
  "name": "Claude Buddy — Usage Mood Tracker",
  "version": "0.1.0",
  "description": "A tiny pixel-art companion that lives on every page you visit and reacts to how close you are to your Claude.ai usage limit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/mascot.js", "content/overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/hero-rope-mask.png", "assets/hero-body.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options/options.html"
}
